# Example configuration for ita-matrix-mcp. Copy to .env and adjust; .env is gitignored, so real values never get committed.
#
# Node 20.6+ can load the file directly:
#   node --env-file=.env src/http-server.js
#
# Every variable is optional. Lines starting with "#" are unset by default; remove the "#" to use one.

# --- HTTP server only (src/http-server.js) -------------------------------------------------------------------------

# Listen port.
PORT=3000

# Mounts MCP at /mcp/<secret> instead of /mcp, so the URL itself acts as the credential.
# Use a long random value, e.g. the output of: openssl rand -hex 24
# ITA_MATRIX_SECRET_PATH=

# Comma-separated Host allowlist, guarding against DNS rebinding. Example: mcp.example.com
# ITA_MATRIX_ALLOWED_HOSTS=

# --- Both entrypoints (stdio and HTTP) -----------------------------------------------------------------------------

# Pin the upstream Matrix API key instead of discovering it automatically. Normally leave this unset.
# ITA_MATRIX_API_KEY=

# Directory for the 30-day cache of the discovered API key (file: api-key.json).
# Default: ~/.cache/ita-matrix-mcp
# ITA_MATRIX_CACHE_DIR=

# Upstream timeout in milliseconds. Multi-city searches are slow.
ITA_MATRIX_TIMEOUT_MS=150000
